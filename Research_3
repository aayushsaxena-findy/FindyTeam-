def call_github_user(username):
    # The GitHub API URL for user data
    url = f"https://api.github.com/users/{username}"
    
    # Making the GET request (Calling the API)
    response = requests.get(url)
    
    # Check if the "call" was successful (Status Code 200)
    if response.status_code == 200:
        data = response.json()
        
        print(f"\n📞 Connection Established: {username}")
        print("-" * 30)
        print(f"👤 Name:       {data.get('name')}")
        print(f"📝 Bio:        {data.get('bio')}")
        print(f"📍 Location:   {data.get('location')}")
        print(f"🏢 Company:    {data.get('company')}")
        print(f"📦 Repos:      {data.get('public_repos')}")
        print(f"👥 Followers:  {data.get('followers')}")
        print("-" * 30)
        print(f"🔗 Profile:    {data.get('html_url')}\n")
        
    elif response.status_code == 404:
        print(f"\n❌ Error: User '{username}' not found. Are you sure the spelling is right?")
        
    else:
        print(f"\n⚠️ Something went wrong. Status Code: {response.status_code}")

# Main execution loop
if __name__ == "__main__":
    while True:
        user_input = input("Enter GitHub username to call (or 'quit' to exit): ")
        if user_input.lower() == 'quit':
            break
        call_github_user(user_input)
